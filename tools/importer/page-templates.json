{
  "metadata": {
    "projectType": "da"
  },
  "templates": [
    {
      "name": "all-pages",
      "description": "Content-driven template covering every page of the legacy WKND source site. Blocks are detected by the BLOCK_REGISTRY in import.js; the brand transformer rebrands all output to Rockstar Adventures.",
      "urls": [
        "https://wknd-adventures.com/index.html",
        "https://wknd-adventures.com/adventures.html",
        "https://wknd-adventures.com/field-notes",
        "https://wknd-adventures.com/community.html",
        "https://wknd-adventures.com/sustainability.html",
        "https://wknd-adventures.com/about.html",
        "https://wknd-adventures.com/faq.html",
        "https://wknd-adventures.com/destinations.html",
        "https://wknd-adventures.com/expeditions.html",
        "https://wknd-adventures.com/gear.html",
        "https://wknd-adventures.com/blog/patagonia-trek.html",
        "https://wknd-adventures.com/blog/kayaking-norway.html",
        "https://wknd-adventures.com/blog/alpine-cycling.html",
        "https://wknd-adventures.com/blog/yosemite-rock-climbing.html",
        "https://wknd-adventures.com/blog/mountain-photography.html",
        "https://wknd-adventures.com/blog/ultralight-backpacking.html"
      ],
      "blocks": [
        { "name": "hero-article", "instances": [".hero-section:has(.article-byline)"] },
        { "name": "hero", "instances": [".hero-section"] },
        { "name": "tabs-activity", "instances": [".tab-container--wide"] },
        { "name": "tabs-team", "instances": ["section:has(.tab-menu):has(.profile-circle)"] },
        { "name": "featured-article", "instances": [".featured-article"] },
        { "name": "editorial-index", "instances": [".editorial-index"] },
        { "name": "faq-list", "instances": [".faq-list"] },
        { "name": "ticker", "instances": [".ticker-strip"] },
        { "name": "columns-pullquote", "instances": [".grid-layout:has(.pull-quote)"] },
        { "name": "columns-promo", "instances": [".grid-layout--2col:has(.card)"] },
        { "name": "columns-about", "instances": [".tablet-1-column:not(:has(.card))"] },
        { "name": "cards-article", "instances": [".grid-layout:has(.article-card)"] },
        { "name": "cards-feature", "instances": [".grid-layout:has(.card-body):not(:has(.article-card))"] },
        { "name": "gallery", "instances": [".grid-layout:has(.gallery-img)"] }
      ]
    }
  ]
}
